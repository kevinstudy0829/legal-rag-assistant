# ============================================
# 複製本檔為 .env 後填入實際數值，切勿把 .env 上傳到公開版控
# ============================================

# --- PostgreSQL（需已安裝 pgvector 擴充）---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legal_rag

# --- Gemini API ---
# 於 https://aistudio.google.com/app/apikey 取得
GEMINI_API_KEY=your_gemini_api_key_here
# 模型名稱變動頻繁，建議先至 https://ai.google.dev/gemini-api/docs/models 確認目前可用模型
# 也可用別名 gemini-flash-latest / gemini-pro-latest 讓程式自動跟隨官方最新版本
GEMINI_MODEL=gemini-flash-latest

# --- 向量化模型（BGE-M3，來自 BAAI，透過 sentence-transformers 載入）---
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
# BGE-M3 dense 向量維度固定為 1024，勿更動
EMBEDDING_DIM=1024

# --- 重排序模型（選用）---
ENABLE_RERANK=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# --- 混合檢索（向量 + 關鍵字 trigram）---
ENABLE_HYBRID_SEARCH=true

# --- 檢索參數 ---
# 第一階段（向量/關鍵字）各自取回的候選數
TOP_K_CANDIDATES=20
# 最終送入 LLM 的參考條文數
TOP_K_FINAL=5

# --- 分塊參數 ---
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=150

# --- 刑法來源（法務部「政府資料開放平臺」官方法律資料檔，非爬蟲）---
LAW_NAME=中華民國刑法
LAW_BULK_XML_URL=https://sendlaw.moj.gov.tw/PublicData/GetFile.ashx?DType=RAW_XML&AuData=CF
LAW_SOURCE_PAGE_URL=https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=C0000001
